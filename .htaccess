# ════════════════════════════════════════════════════════════
# Paroki Santo Andreas Rasul - Server Configuration (.htaccess)
# Clean URLs (Pretty URLs), Security & Performance
# ════════════════════════════════════════════════════════════

# 1. Matikan Directory Listing (Keamanan: Mencegah orang melihat daftar file di folder)
Options -Indexes

# 2. Aktifkan URL Rewriting (Menghilangkan .html dan index.html)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect /index.html ke / (root URL bersih)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*index\.html\ HTTP/
    RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

    # Redirect URL dengan ekstensi .html ke URL bersih tanpa .html (misal: /profil.html -> /profil)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/
    RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

    # Sajikan file .html di balik layar jika URL diakses tanpa ekstensi (misal: /profil -> profil.html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # Dukungan Clean URLs untuk sub-folder seperti admin/dashboard
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)/?$ $1.html [L]
</IfModule>

# 3. Security Headers (Keamanan Tambahan)
<IfModule mod_headers.c>
    # Mencegah website di-embed di iframe luar (Clickjacking protection)
    Header always set X-Frame-Options "SAMEORIGIN"
    # Mencegah MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Referrer policy untuk privasi
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Browser Caching & Kompresi (Kecepatan Loading)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
